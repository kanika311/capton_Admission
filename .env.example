# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Uses local/Atlas, or auto-spawns embedded MongoDB if local server is not running)
MONGO_URI=mongodb://127.0.0.1:27017/captonadmission

# JWT Authentication
JWT_SECRET=capton_admission_jwt_super_secret_key_2026_secure
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Service (Nodemailer - optional, fallback logs to console)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM="CaptonAdmission <no-reply@captonadmission.com>"

# Cloudinary (Optional: for cloud media storage; falls back to local static disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
